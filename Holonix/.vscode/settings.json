{
  "css.lint.unknownAtRules": "ignore",
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.angular/cache": true,
    "**/bin": true,
    "**/obj": true,
    "**/TestResults": true,
    "**/coverage": true,
    ".dev-runtime": true,
    ".dotnet-cli": true,
    ".dotnet-home": true,
    "temp-build-out": true,
    "**/tmp-*.log": true,
    "client-dev.log": true,
    "client-dev.err.log": true,
    "server-dev.log": true,
    "server-dev.err.log": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.angular/cache/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/TestResults/**": true,
    "**/coverage/**": true,
    ".dev-runtime/**": true,
    "temp-build-out/**": true,
    "**/tmp-*.log": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.angular/cache/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    ".dev-runtime/**": true
  }
}
